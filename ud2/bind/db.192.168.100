$TTL 86400
@   IN  SOA ns1.techcorp.lan. admin.techcorp.lan. (
        2026110401 ; Serial
        3600       ; Refresh
        1800       ; Retry
        604800     ; Expire
        86400      ; Negative Cache TTL
)

; Servidor de noms
@       IN  NS      ns1.techcorp.lan.

; Registres PTR - correspon a 192.168.0.100.XX
10      IN  PTR     ns1.techcorp.lan.
1       IN  PTR     gw.techcorp.lan.
20      IN  PTR     web.techcorp.lan.
30      IN  PTR     mail.techcorp.lan.
